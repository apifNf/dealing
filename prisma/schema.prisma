// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum ListingStatus {
  PENDING
  APPROVED
  REJECTED
}

// End-user account (buyer or seller) — separate from the admin passcode auth
// in lib/adminAuth.ts. Gates the onboarding submission flow (see proxy.ts).
model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())

  resetTokens     PasswordResetToken[]
  listings        Listing[]
  buyerLeads      BuyerLead[]
  ndaAcceptances  NdaAcceptance[]
  chatRoomsBuying ChatRoom[]           @relation("ChatRoomBuyer")
  chatRoomsSelling ChatRoom[]          @relation("ChatRoomSeller")
  chatMessages    ChatMessage[]

  @@map("users")
}

// One row per forgot-password request; tokens are single-use (usedAt) and
// expire after 1 hour (see lib/passwordReset.ts). Kept separate from User so
// multiple outstanding requests never clobber each other.
model PasswordResetToken {
  id        String    @id @default(cuid())
  token     String    @unique
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@map("password_reset_tokens")
}

// `repositoryLink` / `mrr` / `techStack` only apply to the SaaS category;
// `assetUrl` / `avgWatchTime` / `monthlyTraffic` / `monthlyRevenue` cover
// Content Account and Website/Media instead (see lib/validations/onboarding.ts).
// All of them are nullable so a single row shape can store any category
// without losing data for the other two.
model Listing {
  id                   String        @id @default(cuid())
  category             String
  repositoryLink       String?
  mrr                  Float?
  techStack            String?
  assetUrl             String?
  avgWatchTime         String?
  monthlyTraffic       Float?
  monthlyRevenue       Float?
  // Newsletter & Komunitas / E-Commerce & Toko Digital
  platformName         String?
  subscriberCount      Float?
  openRate             Float?
  niche                String?
  storeName            String?
  skuCount             Float?
  reasonForSelling     String?
  // Required (enforced in lib/validations/onboarding.ts) for every new
  // submission — nullable here only because listings submitted before this
  // field existed have no value to backfill.
  contactInfo          String?
  fileNames            String[]      @default([])
  status               ListingStatus @default(PENDING)
  // Set when an admin clicks "Share ke Membership" — a deliberate, manual,
  // per-listing decision (see components/admin/ListingsTable.tsx), not
  // something every APPROVED listing gets automatically.
  sharedToMembershipAt DateTime?
  // Recorded when the submitter is logged in; not required to submit.
  userId               String?
  user                 User?         @relation(fields: [userId], references: [id])
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt

  ndaAcceptances NdaAcceptance[]
  chatRooms      ChatRoom[]

  @@map("listings")
}

// Membership applications (see app/membership). Reuses ListingStatus since
// the same PENDING/APPROVED/REJECTED workflow applies here too.
model Member {
  id          String        @id @default(cuid())
  name        String
  contactInfo String
  reason      String?
  status      ListingStatus @default(PENDING)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@map("members")
}

// Captured from the "Preferensi Akuisisi Anda" step (Saya Ingin Mengakuisisi
// -> BuyerWizard). Kept as its own model, separate from Listing, since a
// buyer lead isn't tied to one specific listing.
model BuyerLead {
  id                   String   @id @default(cuid())
  budgetRange          String
  categoriesOfInterest String[]
  contactInfo          String
  // Recorded when the submitter is logged in; not required to submit.
  userId               String?
  user                 User?    @relation(fields: [userId], references: [id])
  createdAt            DateTime @default(now())

  @@map("buyer_leads")
}

// Dedup record for the Gatekeeper: one row per (listing, buyerLead) pair
// that has already been matched/notified, so re-running the matcher (or a
// listing somehow being re-approved) never sends a duplicate notification.
model MatchNotification {
  id          String   @id @default(cuid())
  listingId   String
  buyerLeadId String
  createdAt   DateTime @default(now())

  @@unique([listingId, buyerLeadId])
  @@map("match_notifications")
}

// Click-to-accept NDA, recorded per (listing, buyer) — a buyer must accept
// again for each different listing they want to discuss (see lib/nda.ts for
// the displayed text). Required before a ChatRoom can be requested.
model NdaAcceptance {
  id         String   @id @default(cuid())
  listingId  String
  listing    Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  acceptedAt DateTime @default(now())
  ipAddress  String?

  @@unique([listingId, userId])
  @@map("nda_acceptances")
}

enum ChatRoomStatus {
  REQUESTED
  ACTIVE
  REJECTED
  CLOSED
}

// One in-app chat thread between a buyer and a listing's seller. Created as
// REQUESTED when a buyer asks to discuss a listing (after accepting the
// NDA); an admin must approve it to ACTIVE before either side can message —
// see app/admin/dashboard/actions.ts and app/chat/[roomId].
model ChatRoom {
  id           String         @id @default(cuid())
  listingId    String
  listing      Listing        @relation(fields: [listingId], references: [id], onDelete: Cascade)
  buyerUserId  String
  buyer        User           @relation("ChatRoomBuyer", fields: [buyerUserId], references: [id], onDelete: Cascade)
  sellerUserId String
  seller       User           @relation("ChatRoomSeller", fields: [sellerUserId], references: [id], onDelete: Cascade)
  status       ChatRoomStatus @default(REQUESTED)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  messages ChatMessage[]

  @@map("chat_rooms")
}

model ChatMessage {
  id           String   @id @default(cuid())
  chatRoomId   String
  chatRoom     ChatRoom @relation(fields: [chatRoomId], references: [id], onDelete: Cascade)
  senderUserId String
  sender       User     @relation(fields: [senderUserId], references: [id], onDelete: Cascade)
  content      String
  // Best-effort heuristic flag (see lib/chat/moderation.ts) when a message
  // looks like it's sharing off-platform contact info — surfaced to admin
  // monitoring, not auto-enforced.
  flagged      Boolean  @default(false)
  createdAt    DateTime @default(now())

  @@map("chat_messages")
}
