// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum ListingStatus {
  PENDING
  APPROVED
  REJECTED
}

// `repositoryLink` / `mrr` / `techStack` only apply to the SaaS category;
// `assetUrl` / `avgWatchTime` / `monthlyTraffic` / `monthlyRevenue` cover
// Content Account and Website/Media instead (see lib/validations/onboarding.ts).
// All of them are nullable so a single row shape can store any category
// without losing data for the other two.
model Listing {
  id             String        @id @default(cuid())
  category       String
  repositoryLink String?
  mrr            Float?
  techStack      String?
  assetUrl       String?
  avgWatchTime   String?
  monthlyTraffic Float?
  monthlyRevenue Float?
  fileNames      String[]      @default([])
  status         ListingStatus @default(PENDING)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@map("listings")
}
