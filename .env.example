# Copy this file to .env.local (and .env for DATABASE_URL, which Prisma's
# CLI only reads from .env) and fill in real values. Never commit the
# filled-in files — .env* is gitignored except for this example.

# Postgres connection string (see /root/postgres-docker on the VPS).
# Prisma's CLI (migrate/generate) only reads this from .env, not .env.local.
DATABASE_URL="postgresql://user:password@localhost:5432/dealing?schema=public"

# n8n webhook endpoints consumed by app/onboarding/actions.ts.
# Test URL shape:       https://<your-n8n-host>/webhook-test/<path>
# Production URL shape: https://<your-n8n-host>/webhook/<path>
N8N_SELLER_WEBHOOK_URL=
N8N_BUYER_WEBHOOK_URL=

# Telegram notifications (used by n8n workflows to alert on new submissions).
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Passcode gate for /admin/* (see proxy.ts + lib/adminAuth.ts).
ADMIN_PASSCODE=
